@{
    Layout = "_Layout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SGS | Ship Your SaaS</title>
-</head>

<body>

    <header class="py-5 text-center bg-white">
        <div class="container py-5">
            <h1 class="display-4 fw-bold">Launch your SaaS <br>in a weekend with SGS.</h1>

            <p class="lead text-muted mx-auto mb-4" style="max-width:600px;">
                The essential .NET starter kit for building modern web applications.
                SGS provides the features you need to ship faster.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a href="#" class="btn btn-primary px-4">Buy SGS Boilerplate</a>
                <a href="#" class="btn btn-outline-primary px-4">View Demo</a>
            </div>
        </div>
    </header>

    <section class="py-5 bg-light">
        <div class="container text-center">
            <h2 class="fw-bold mb-5">Stop wasting time on setup</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <h1 class="fw-bold text-primary">120+</h1>
                    <p class="text-muted">Hours saved with SGS Auth & Billing</p>
                </div>
                <div class="col-md-4">
                    <h1 class="fw-bold text-primary">0</h1>
                    <p class="text-muted">Database configuration required</p>
                </div>
                <div class="col-md-4">
                    <h1 class="fw-bold text-primary">1st Day</h1>
                    <p class="text-muted">Time to first SGS production deploy</p>
                </div>
            </div>
        </div>
    </section>

    <section id="how-it-works" class="py-5">
        <div class="container">

            <h2 class="text-center fw-bold mb-5">3 Steps to SGS Integration</h2>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <span class="badge bg-primary rounded-circle mb-3">1</span>
                            <h5 class="fw-bold">Clone SGS Repo</h5>
                            <p class="text-muted small">
                                Download source code and add your keys to <code>appsettings.json</code>.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <span class="badge bg-primary rounded-circle mb-3">2</span>
                            <h5 class="fw-bold">Customize UI</h5>
                            <p class="text-muted small">
                                Update branding and build your core business features.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <span class="badge bg-primary rounded-circle mb-3">3</span>
                            <h5 class="fw-bold">Deploy SGS</h5>
                            <p class="text-muted small">
                                Use GitHub Actions to deploy SGS to your cloud provider.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="py-5 bg-light">
        <div class="container text-center">
            <h2 class="fw-bold mb-4">Build with SGS Community</h2>
            <p class="text-muted mb-4">
                Join 500+ .NET developers in our private SGS Slack community.
            </p>

            <div class="row justify-content-center g-4">

                <div class="col-md-3">
                    <p class="fw-bold">Private Channel</p>
                </div>

                <div class="col-md-3">
                    <p class="fw-bold">Weekly Office Hours</p>
                </div>

                <div class="col-md-3">
                    <p class="fw-bold">Direct Repo Access</p>
                </div>
                <div class="col-md-3">
                    <p class="fw-bold">24h Response Time</p>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">

            <h2 class="text-center fw-bold mb-5">What our SGS users say</h2>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <p class="fst-italic text-muted">
                                "SGS saved me literally weeks of work. The Stripe integration alone is worth the price."
                            </p>

                            <p class="fw-bold mb-0">Alex Rivera</p>
                            <small class="text-muted">Founder, ShipFast</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <p class="fst-italic text-muted">
                                "The clean SGS architecture makes it so easy to maintain."
                            </p>

                            <p class="fw-bold mb-0">Sarah Chen</p>
                            <small class="text-muted">CTO, DevScale</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="pricing" class="py-5 bg-light">
        <div class="container">

            <h2 class="text-center fw-bold mb-5">Simple SGS Pricing</h2>

            <div class="row g-4 justify-content-center">

                <div class="col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">

                            <h5 class="fw-bold">SGS Standard</h5>
                            <p class="text-muted small">Perfect for side projects</p>

                            <h1 class="text-primary fw-bold">$149</h1>

                            <button class="btn btn-outline-primary w-100 mt-4">
                                Get Started
                            </button>

                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100 border-primary shadow">
                        <div class="card-body text-center">

                            <h5 class="fw-bold">SGS Unlimited</h5>
                            <p class="text-muted small">For entrepreneurs</p>

                            <h1 class="text-primary fw-bold">$299</h1>

                            <button class="btn btn-primary w-100 mt-4">
                                Buy SGS Unlimited
                            </button>

                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">

                            <h5 class="fw-bold">SGS Enterprise</h5>
                            <p class="text-muted small">For teams</p>

                            <h1 class="text-primary fw-bold">$799</h1>

                            <button class="btn btn-outline-primary w-100 mt-4">
                                Contact Sales
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <footer class="py-5 border-top bg-white">
        <div class="container text-center">
            <p class="text-muted mb-0">© 2026 SGS. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>