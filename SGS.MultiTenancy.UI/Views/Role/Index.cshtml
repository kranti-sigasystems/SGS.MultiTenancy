@using SGS.MultiTenancy.Core.Application.DTOs.Role
@using SGS.MultiTenancy.Core.Domain.Common
@model PagedListViewModel<RoleDto>
@{
    ViewData["Title"] = "Roles";
    var query = Context.Request.Query;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h4 class="fw-semibold mb-0">Roles Management</h4>

        <a asp-action="Create"
           class="btn btn-outline-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i> Create Role
        </a>
    </div>
    <form method="get" asp-action="Index" class="row g-2 mb-4">

        <div class="col-md-3">
            <input type="text"
                   name="SearchTerm"
                   value="@query["SearchTerm"]"
                   class="form-control"
                   placeholder="Keyword Search" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>

    </form>
    <div class="card border-0 shadow">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 border-radius-top-start-2xl">Role Name</th>
                            <th class="py-3">Description</th>
                            <th class="py-3 text-center">Default</th>
                            <th class="py-3 text-end border-radius-top-end-2xl">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.Items != null && Model.Data.Items.Any())
                        {
                            foreach (var role in Model.Data.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@role.Name</td>

                                    <td class="text-muted small">
                                        @role.Description
                                    </td>

                                    <td class="text-center">
                                        <span class="badge @(role.IsDefault ? "bg-success" : "bg-secondary")">
                                            @(role.IsDefault ? "Yes" : "No")
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        @if (role.TenantID != Guid.Empty)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@role.ID"
                                               class="btn btn-sm btn-link text-muted">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </a>

                                            <button class="btn btn-sm btn-link text-muted"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal-@role.ID">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <i class="bi bi-lock-fill text-muted fs-5" title="System Role"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <hr />
            <!-- Pagination kept unchanged -->
            <nav class="mt-4">
                <ul class="pagination justify-content-end">
                    <li class="page-item rounded-circle">

                        <form method="get" asp-action="Index" class="d-flex align-items-center w-100 h-100 border-0">

                            <input type="hidden" name="page" value="Page Limit-@{
                            @Model.Data.PageNumber
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                